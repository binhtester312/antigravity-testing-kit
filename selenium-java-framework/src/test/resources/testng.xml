<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Perfex CRM — Automation Full Test Suite"
       verbose="2"
       thread-count="1"
       parallel="none">

    <listeners>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
    </listeners>

    <!-- ============================================
         SUITE 1: Module Login (Authentications)
    ============================================ -->
    <test name="[MODULE 1] Authentication and Login Tests" preserve-order="true">
        <classes>
            <class name="com.anhtester.tests.login.LoginTest"/>
        </classes>
    </test>

    <!-- ============================================
         SUITE 2: Module Customers (Management)
    ============================================ -->
    <test name="[MODULE 2] Customers Management Tests" preserve-order="true">
        <classes>
            <class name="com.anhtester.tests.customer.CustomerTest"/>
        </classes>
    </test>

    <!-- ============================================
         SUITE 3: Module Projects (Management)
    ============================================ -->
    <test name="[MODULE 3] Projects Management Tests" preserve-order="true">
        <classes>
            <class name="com.anhtester.tests.project.ProjectTest"/>
        </classes>
    </test>

    <!-- ============================================
         SUITE 4: Module Contracts (Management)
    ============================================ -->
    <test name="[MODULE 4] Contracts Management Tests" preserve-order="true">
        <classes>
            <class name="com.anhtester.tests.contract.ContractTest"/>
        </classes>
    </test>

    <!-- ============================================
         SUITE 5: Module Dashboard (Overview & Widgets)
    ============================================ -->
    <test name="[MODULE 5] Dashboard Management Tests" preserve-order="true">
        <classes>
            <class name="com.anhtester.tests.dashboard.DashboardTest"/>
        </classes>
    </test>

</suite>
